generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid()) @map("_id")
  email           String   @unique
  username        String   @unique
  passwordHash    String
  emailVerified   Boolean  @default(false)
  role            String   @default("user")  // "user" | "admin"
  credits         Int      @default(20)
  lastDailyGrant  String?  // ISO date of last daily credit grant
  profileImageUrl String?  // data URL or stored URL for avatar
  theme           String?  // "dark" | "light" | "system"
  aiLanguage      String?  // e.g. "en", "es" - preferred language for AI replies
  plan            String?  // e.g. "free", "pro" - for display
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  scripts         Script[]
}

model RedeemKey {
  id        String    @id @default(cuid()) @map("_id")
  code      String    @unique // the key string users enter
  credits   Int       // generations granted when redeemed
  plan      String?   // optional plan name
  expiresAt DateTime? // optional expiry
  usedById  String?   // userId who redeemed (null = unused)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Script {
  id                   String   @id @default(cuid()) @map("_id")
  title                String   @default("Untitled Script")
  content              String   @default("")
  conversationHistory  String?  // JSON array of { role, content, code?, isPartial? }
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CommunityScript {
  id           String    @id @default(cuid()) @map("_id")
  userId       String    // author
  title        String
  description  String?   @default("")
  content      String    @default("") // script code at time of share
  imageUrl     String?   // optional preview image (data URL or stored)
  madeByAI     Boolean   @default(false)
  views        Int       @default(0)
  verified     Boolean   @default(false)  // admin verified as safe
  verifiedAt   DateTime?
  verifiedById String?   // admin userId who verified
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     Comment[]
}

model Comment {
  id                String   @id @default(cuid()) @map("_id")
  communityScriptId String
  userId            String
  content           String
  createdAt         DateTime @default(now())
  script            CommunityScript @relation(fields: [communityScriptId], references: [id])
}

model Report {
  id         String   @id @default(cuid()) @map("_id")
  reporterId String   // user who reported
  targetType String   // "script" | "account"
  targetId   String   // CommunityScript id or User id
  reason     String   // inappropriate_script, malicious_script, inappropriate_images, inappropriate_username, other
  details    String?  // for "other"
  status     String   @default("pending") // pending, reviewed, dismissed
  createdAt  DateTime @default(now())
}
